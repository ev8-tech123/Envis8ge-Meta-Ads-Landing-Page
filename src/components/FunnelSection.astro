---
import { funnel } from "../data/content";
import SectionHeading from "./SectionHeading.astro";
---

<section class="bg-[var(--color-background)]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-20">
    <SectionHeading headline={funnel.headline} supporting={funnel.supporting} />

    <div class="mt-10 max-w-md mx-auto flex flex-col items-center">
      {funnel.stages.map((stage, i) => {
        const width = 100 - i * 12;
        return (
          <>
            <div
              class="w-full text-center rounded-[var(--radius-md)] py-3 font-semibold text-black"
              style={`width: ${width}%; background: color-mix(in srgb, #02baf9 ${100 - i * 12}%, #bdf3d3);`}
            >
              {stage}
            </div>
            {i < funnel.stages.length - 1 && (
              <span class="my-1 text-[var(--color-neutral-400)]" aria-hidden="true">&darr;</span>
            )}
          </>
        );
      })}
    </div>
  </div>
</section>

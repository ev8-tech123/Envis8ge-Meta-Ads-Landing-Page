---
import { credibility } from "../data/content";
---

<section class="bg-[var(--color-neutral-900)] text-white">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-8 sm:py-10">
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 text-center">
      {credibility.stats.map((stat) => (
        <div>
          <p class="text-4xl md:text-5xl font-bold text-[var(--color-primary)]">{stat.value}</p>
          <p class="mt-1 text-sm text-white/70">{stat.label}</p>
        </div>
      ))}
    </div>
  </div>
</section>

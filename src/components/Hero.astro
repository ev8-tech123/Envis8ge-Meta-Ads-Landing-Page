---
import { hero } from "../data/content";
import CtaButton from "./CtaButton.astro";
---

<section class="relative overflow-hidden bg-[var(--color-background)]">
  <div
    class="pointer-events-none absolute -top-24 -right-24 h-72 w-72 sm:h-96 sm:w-96 rounded-full opacity-30 blur-3xl"
    style="background: linear-gradient(124deg, #bdf3d3 0%, #20c1fa 60%);"
    aria-hidden="true"
  >
  </div>

  <!-- Wider than other sections (max-w-7xl) and a 2:3 split from xl so the video gets ~60% of the row. -->
  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 pt-10 pb-14 sm:pt-16 sm:pb-20 grid gap-10 lg:gap-12 lg:grid-cols-2 xl:grid-cols-[minmax(0,2fr)_minmax(0,3fr)] lg:items-center">
    <div class="min-w-0">
      <p class="text-sm font-semibold uppercase tracking-wide text-[var(--color-primary-text)] mb-4">
        {hero.eyebrow}
      </p>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold leading-tight text-[var(--color-neutral-900)]">
        {hero.headline}
      </h1>
      <p class="mt-5 text-base sm:text-lg text-[var(--color-neutral-600)] max-w-xl">
        {hero.supporting}
      </p>
      <div class="mt-8 flex flex-col sm:flex-row items-start sm:items-center gap-4 sm:gap-6">
        <CtaButton href="#lead-form" variant="primary" size="sm">{hero.primaryCta}</CtaButton>
        <a
          href="#lead-form"
          class="group inline-flex items-center gap-1.5 text-sm font-semibold text-[var(--color-neutral-800)] underline decoration-[var(--color-primary)] decoration-2 underline-offset-4 hover:text-[var(--color-primary-text)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)] rounded-sm"
        >
          {hero.secondaryCta}
          <span class="transition-transform duration-150 group-hover:translate-x-0.5" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- 1920x1080 web encode of "envis8ge lead gen (1).mp4" (original exceeds Cloudflare's 25 MiB asset limit);
         aspect-video reserves the box so nothing shifts while it loads. -->
    <video
      class="aspect-video w-full rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-black"
      src="/video/envis8ge-lead-gen-web.mp4"
      width="1920"
      height="1080"
      controls
      autoplay
      muted
      playsinline
      preload="metadata"
      aria-label="Envis8ge lead generation video"
    ></video>
  </div>
</section>

---
import { caseStudies } from "../data/content";
import SectionHeading from "./SectionHeading.astro";
---

<section class="bg-[var(--color-background)]">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-16 sm:py-20">
    <SectionHeading headline={caseStudies.headline} supporting={caseStudies.supporting} />

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {caseStudies.items.map((item) => (
        <div class="rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[#eef9fd] p-6 sm:p-7">
          <h3 class="mb-5 text-xl sm:text-2xl font-bold text-[var(--color-neutral-900)]">{item.name}</h3>

          <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-primary-text)]">Client / Industry</p>
          <p class="mt-1 font-semibold text-[var(--color-neutral-800)]">{item.client}</p>

          <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-[var(--color-primary-text)]">Challenge</p>
          <p class="mt-1 text-[var(--color-neutral-600)]">{item.challenge}</p>

          <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-[var(--color-primary-text)]">What We Changed</p>
          <p class="mt-1 text-[var(--color-neutral-600)]">{item.whatWeChanged}</p>

          <p class="mt-5 text-xs font-semibold uppercase tracking-wide text-[var(--color-primary-text)]">Result</p>
          <p class="mt-1 text-2xl sm:text-3xl font-bold text-[var(--color-primary-text)]">{item.result.value}</p>
          <p class="mt-1 font-semibold text-[var(--color-neutral-900)]">{item.result.label}</p>
          <p class="mt-1 text-[var(--color-neutral-600)]">{item.result.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>

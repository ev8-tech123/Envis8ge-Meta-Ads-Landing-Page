---
import { cta } from "../data/content";
import CtaButton from "./CtaButton.astro";
---

<section class="bg-[var(--color-neutral-900)] text-white">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-20 text-center">
    <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold leading-tight">{cta.finalHeadline}</h2>
    <p class="mt-4 text-base sm:text-lg text-white/70">{cta.finalSupporting}</p>
    <div class="mt-8">
      <CtaButton href="#lead-form" variant="primary">{cta.finalCta}</CtaButton>
    </div>
  </div>
</section>

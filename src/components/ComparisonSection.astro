---
import { comparison } from "../data/content";
import SectionHeading from "./SectionHeading.astro";
---

<section class="bg-[var(--color-neutral-100)]">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 py-16 sm:py-20">
    <SectionHeading headline={comparison.headline} />

    <div class="mt-10 overflow-x-auto">
      <table class="w-full min-w-[560px] border-separate border-spacing-0 rounded-[var(--radius-lg)] overflow-hidden border border-[var(--color-border)]">
        <thead>
          <tr>
            <th class="bg-[var(--color-background)] text-left p-4 text-sm font-semibold text-[var(--color-neutral-600)] border-b border-[var(--color-border)]">
              {comparison.columnA}
            </th>
            <th class="bg-[var(--color-primary)] text-left p-4 text-sm font-semibold text-black border-b border-[var(--color-border)]">
              {comparison.columnB}
            </th>
          </tr>
        </thead>
        <tbody>
          {comparison.rows.map((row) => (
            <tr>
              <td class="p-4 text-sm text-[var(--color-neutral-600)] bg-[var(--color-background)] border-b border-[var(--color-border)]">
                {row.typical}
              </td>
              <td class="p-4 text-sm font-medium text-[var(--color-neutral-900)] bg-[var(--color-primary-tint)]/30 border-b border-[var(--color-border)]">
                {row.envis8ge}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

---
// Recreates envis8ge.com's "Brands we've worked with" carousel: same logos, card sizes,
// tint background, edge fade and 140s right-to-left loop (sm = site's 40rem "tablet",
// lg = its 64rem "desktop").
import { brands } from "../data/content";

// The list is rendered twice and the track slides by exactly half its width, so the
// second copy lands where the first started and the loop has no visible jump.
const loop = [...brands.logos, ...brands.logos];
---

<section class="bg-[var(--color-primary-tint)]/40 py-16 sm:py-20 lg:py-24">
  <div class="mx-auto w-full max-w-[1200px] px-4 sm:px-6">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-[var(--color-foreground)]">{brands.headline}</h2>
    </div>

    <div class="brands-fade mt-10 overflow-hidden">
      <div class="brands-track flex w-max">
        {loop.map((logo, i) => (
          <div
            class="mr-4 flex h-24 w-[168px] shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-white p-4 shadow-[0_1px_2px_#0000000f] transition-shadow duration-[250ms] ease-[cubic-bezier(0,0,0.2,1)] hover:shadow-md sm:h-28 sm:w-[204px]"
            aria-hidden={i >= brands.logos.length ? "true" : undefined}
          >
            <img
              src={`/brands/${logo.file}.webp`}
              alt={i >= brands.logos.length ? "" : logo.alt}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-contain"
            />
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .brands-fade {
    -webkit-mask-image: linear-gradient(90deg, #0000, #000 8% 92%, #0000);
    mask-image: linear-gradient(90deg, #0000, #000 8% 92%, #0000);
  }

  .brands-track {
    animation: brands-marquee 140s linear infinite;
    will-change: transform;
  }

  .brands-track:hover {
    animation-play-state: paused;
  }

  @keyframes brands-marquee {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }
</style>

---

<div class="mt-8">
  <p class="text-xs font-semibold uppercase tracking-wide text-[var(--color-neutral-500)] mb-3">
    {platforms.label}
  </p>
  <!-- Icon stacked above the name keeps all five on one line from phone width up (side-by-side needs ~560px).
       Kept understated next to the headline and CTAs: 22px icons / 10px labels on phones, 24px / 11px from sm up. -->
  <ul class="grid grid-cols-5 gap-x-1 gap-y-3 sm:flex sm:flex-wrap sm:items-start sm:gap-x-6" role="list">
    {platforms.items.map(({ key, name }) => (
      <li class="flex flex-col items-center gap-1 text-[10px] sm:text-[11px] leading-tight font-semibold text-[var(--color-neutral-700)]">
        <svg
          viewBox="0 0 24 24"
          class="h-[22px] w-[22px] sm:h-6 sm:w-6 shrink-0"
          fill={marks[key].color}
          aria-hidden="true"
          focusable="false"
        >
          <path d={marks[key].path} />
        </svg>
        {name}
      </li>
    ))}
  </ul>
</div>

---
import { faq, cta } from "../data/content";
import SectionHeading from "./SectionHeading.astro";
import CtaButton from "./CtaButton.astro";
---

<section class="bg-[var(--color-background)]">
  <div class="mx-auto max-w-3xl px-4 sm:px-6 py-16 sm:py-20">
    <SectionHeading headline={faq.headline} />

    <div class="mt-10 text-center">
      <CtaButton href="#lead-form" variant="secondary" size="md">{cta.primary}</CtaButton>
    </div>

    <!-- Native <details>/<summary> accordion: zero JavaScript. -->
    <div class="mt-10 divide-y divide-[var(--color-border)] border-y border-[var(--color-border)]">
      {faq.items.map((item) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-semibold text-[var(--color-neutral-900)]">
            {item.question}
            <span class="shrink-0 text-[var(--color-primary-text)] transition-transform group-open:rotate-45" aria-hidden="true">
              +
            </span>
          </summary>
          <p class="mt-3 text-[var(--color-neutral-600)]">{item.answer}</p>
        </details>
      ))}
    </div>

    <div class="mt-10 text-center">
      <CtaButton href="#lead-form" variant="primary" size="md">{cta.primary}</CtaButton>
    </div>
  </div>
</section>

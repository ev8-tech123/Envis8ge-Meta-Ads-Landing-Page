---
// Section order is based on the SOP's "Final Recommended Page Flow", with client-requested changes:
// 01 Hero, 02 Credibility (preceded by the Brands logo carousel), 03 Case Studies, 04 Problem, 05 Approach,
// 06 How It Works, 07 Testimonials, 08 Comparison,
// 09 Who It's For, 10 FAQ, 11 Final CTA + Lead Form.
// (Funnel section removed; Testimonials moved ahead of Comparison.)
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BrandsSection from "../components/BrandsSection.astro";
import CredibilityBar from "../components/CredibilityBar.astro";
import CaseStudies from "../components/CaseStudies.astro";
import ProblemSection from "../components/ProblemSection.astro";
import ApproachSection from "../components/ApproachSection.astro";
import HowItWorks from "../components/HowItWorks.astro";
import ComparisonSection from "../components/ComparisonSection.astro";
import TestimonialsSection from "../components/TestimonialsSection.astro";
import WhoItsFor from "../components/WhoItsFor.astro";
import FaqSection from "../components/FaqSection.astro";
import FinalCta from "../components/FinalCta.astro";
import LeadForm from "../components/LeadForm.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout>
  <Header />
  <main>
    <Hero />
    <BrandsSection />
    <CredibilityBar />
    <CaseStudies />
    <ProblemSection />
    <ApproachSection />
    <HowItWorks />
    <TestimonialsSection />
    <ComparisonSection />
    <WhoItsFor />
    <FaqSection />
    <FinalCta />
    <LeadForm />
  </main>
  <Footer />
</BaseLayout>

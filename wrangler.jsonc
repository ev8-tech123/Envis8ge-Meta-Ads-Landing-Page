// Static-assets-only Worker for the landing page at https://envis8ge.com/leadgenads.
// Routes (envis8ge.com/leadgenads and envis8ge.com/leadgenads/*) are deliberately NOT configured here yet:
// they are added only after the workers.dev test URL has been verified and approved.
{
  "name": "envis8ge-leadgen",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    // Serve dist/leadgenads/index.html at /leadgenads (no trailing slash); /leadgenads/ redirects to /leadgenads.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "none"
  }
}
